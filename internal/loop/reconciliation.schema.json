{
  "type": "object",
  "properties": {
    "action": {
      "enum": [
        "no_progress",
        "progress"
      ],
      "description": "no_progress requires empty updates, empty current_step, and null unresolved_focus. progress may update steps or focus."
    },
    "updates": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 512,
                "minLength": 1
              },
              "completion_criteria": {
                "type": "string",
                "maxLength": 512
              },
              "status": {
                "enum": [
                  "pending",
                  "active",
                  "partial",
                  "satisfied",
                  "invalidated",
                  "failed"
                ]
              },
              "outcome": {
                "type": "string",
                "maxLength": 512
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "partition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "path": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^(/|$)"
                    }
                  },
                  "required": [
                    "partition",
                    "version",
                    "path"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8,
                "description": "Cite supplied accepted evidence or a resolvable child JSON pointer within its value, at the same partition and version."
              },
              "information_gaps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 512,
                  "minLength": 1
                },
                "maxItems": 8
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "description",
              "completion_criteria",
              "status",
              "outcome",
              "evidence_refs",
              "information_gaps",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "step"
        ],
        "additionalProperties": false
      },
      "description": "Must be [] when action is no_progress."
    },
    "current_step": {
      "type": "string",
      "maxLength": 64,
      "description": "Must be an empty string when action is no_progress."
    },
    "unresolved_focus": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "description": "null preserves focus; empty string clears it; otherwise concise unresolved intent, never a new strategy or tool sequence."
    }
  },
  "required": [
    "action",
    "updates",
    "current_step",
    "unresolved_focus"
  ],
  "additionalProperties": false
}
